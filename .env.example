# OpenRouter API Configuration
OPENROUTER_API_KEY=sk-or-v1-seu-codigo-aqui

# Supabase — OBRIGATÓRIO para validar os tokens de login.
# SUPABASE_URL é usada para baixar o JWKS (chaves públicas) do projeto,
# que é como os tokens são verificados nos projetos com chaves novas
# ("sb_publishable_..."). Painel: Project Settings → API → Project URL.
SUPABASE_URL=https://seu-projeto.supabase.co

# Necessária apenas para exclusão de conta (Project Settings → API → service_role).
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key

# Somente para projetos ANTIGOS que assinam com HS256 (segredo compartilhado).
# Projetos novos usam chaves assimétricas e não precisam desta variável.
# SUPABASE_JWT_SECRET=seu-jwt-secret

# Modelo LLM (opcional, padrão: anthropic/claude-haiku-4.5)
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# URL do site para HTTP-Referer (opcional)
# SITE_URL=https://o-mister.vercel.app

# Rate limit compartilhado (opcional, recomendado em produção).
# Crie um Redis no Upstash ou Vercel KV e cole as credenciais REST.
# Sem estas variáveis, o rate limit cai para memória (por-instância).
# UPSTASH_REDIS_REST_URL=https://seu-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu-token
# (Alternativamente: KV_REST_API_URL / KV_REST_API_TOKEN)
